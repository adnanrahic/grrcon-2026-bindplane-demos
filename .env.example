# Copy to .env and fill in. Never commit .env.

# Bindplane Cloud secret key. Copy it from the Bindplane UI:
#   Collectors -> Install Collector -> the secret-key value in the install command.
BINDPLANE_SECRET_KEY=

# OpAMP management endpoint. Bindplane Cloud uses wss://; a self-hosted
# server without TLS uses ws://<host>:3001/v1/opamp.
OPAMP_ENDPOINT=wss://app.bindplane.com/v1/opamp

# --- Self-hosted Bindplane (selfhosted/) --------------------------------------
# To point the collectors at the local server, comment out the two values above
# and uncomment these. ws://, not wss:// -- the local stack has no TLS.
#
# The key is GENERATED when you create the project, so paste your own:
#   bindplane --profile local get projects    # the SECRETKEY column
#
# Switching also needs `docker compose down -v` -- each collector persists the
# endpoint it first registered with in its storage volume, and that file wins
# over these vars. `--force-recreate` alone leaves every collector on 401.
#
# Switch the CLI too, or `bindplane apply` still writes to the cloud -- with a
# success message. See selfhosted/README.md.
#
# BINDPLANE_SECRET_KEY=<SECRETKEY from `bindplane get projects`>
# OPAMP_ENDPOINT=ws://host.docker.internal:3001/v1/opamp
# ------------------------------------------------------------------------------

# BDOT collector image tag (ghcr.io/observiq/bindplane-agent).
BDOT_VERSION=1.106.0

# Copy to .env and fill in. Never commit .env.

# Bindplane Cloud secret key. Copy it from the Bindplane UI:
#   Collectors -> Install Collector -> the secret-key value in the install command.
BINDPLANE_SECRET_KEY=

# OpAMP management endpoint. Bindplane Cloud uses wss://; a self-hosted
# server without TLS uses ws://<host>:3001/v1/opamp.
OPAMP_ENDPOINT=wss://app.bindplane.com/v1/opamp

# BDOT collector image tag (ghcr.io/observiq/bindplane-agent).
BDOT_VERSION=1.106.0

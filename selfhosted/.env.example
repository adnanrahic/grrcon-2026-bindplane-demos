# Copy to selfhosted/.env and fill in BINDPLANE_LICENSE. Never commit .env.

# Bindplane EE license. NOT committed -- this repo is public. Get it from your
# Bindplane account or a colleague, and paste it bare: no surrounding quotes.
# Compose does not strip them, so 'H4sIA...' would be read WITH the quotes and
# the server refuses to start.
BINDPLANE_LICENSE=

# NOTE: the collectors' secret key is NOT set here. It belongs to the project
# and is generated by `bindplane create organization` -- read it back with
# `bindplane get projects` and paste it into ../.env. A server-level
# BINDPLANE_SECRET_KEY does not work: agents get a 401. (Verified.)

# Signs the web session cookie. Any UUID; local-only.
BINDPLANE_SESSION_SECRET=88BE8BF4-508D-4B7D-AEB9-81C3A0A256C6

# Web UI and CLI login (self-hosted uses basic auth, not an API key).
BINDPLANE_USERNAME=admin
BINDPLANE_PASSWORD=admin

# Server image tag. Server and collector versions are SEPARATE tracks -- there
# is no bindplane-ee:1.106.0 to match BDOT_VERSION. Applies to all three
# observIQ images here.
BINDPLANE_VERSION=1.102.0

# Host port for UI, CLI and OpAMP. Changing it means changing OPAMP_ENDPOINT in
# ../.env to match.
BINDPLANE_PORT=3001

# Postgres. Local-only.
POSTGRES_DB=bindplane
POSTGRES_USER=bindplane
POSTGRES_PASSWORD=password
